# Public https origin. Leave empty to use the host that serves the request.
NEXT_PUBLIC_SITE_URL=

# AdSense. Both must be set before an ad unit renders. Leave empty to render nothing.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Search Console HTML-tag verification token, without the meta tag wrapper.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Each accepted lead is POSTed here as JSON.
LEAD_WEBHOOK_URL=
